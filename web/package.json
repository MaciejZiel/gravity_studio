{
  "name": "gravity-studio-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser version of Gravity Studio: a Solar System viewer driven by real orbital elements.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
